# Copy to .env (run.sh does this for you). Never commit .env.

# Stripe TEST keys from https://dashboard.stripe.com/test/apikeys
# The app refuses anything that isn't sk_test_/rk_test_.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:8000/stripe/webhook/` (optional locally)
STRIPE_WEBHOOK_SECRET=

SITE_URL=http://localhost:8000
STUDIO_TIMEZONE=America/New_York

# Production only:
# DJANGO_SECRET_KEY=change-me
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=studio.example.com
# POSTGRES_DB=studio
# POSTGRES_USER=studio
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
